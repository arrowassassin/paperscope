{
  "name": "paperscope",
  "displayName": "PaperScope",
  "version": "0.4.3",
  "description": "Local-first document search with exact page and line citations. Search your own documents offline through the paper CLI's built-in MCP server.",
  "author": {
    "name": "kintsugi-tools",
    "url": "https://github.com/kintsugi-tools/paperscope"
  },
  "homepage": "https://github.com/kintsugi-tools/paperscope",
  "repository": "https://github.com/kintsugi-tools/paperscope",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "search",
    "rag",
    "mcp",
    "documents",
    "local-first"
  ],
  "defaultEnabled": true,
  "skills": "./skills",
  "mcpServers": {
    "paper": {
      "command": "paper",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}
